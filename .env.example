# Скопируйте в .env и заполните (не коммитьте .env!)
DJANGO_SECRET_KEY=сгенерируйте-длинный-случайный-ключ-минимум-50-символов
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
DJANGO_SECURE_SSL_REDIRECT=False

# Email (Gmail App Password)
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Optional Click.uz merchant (leave empty for manual card top-ups)
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
